<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080b14">
  <meta name="description" content="ALL-IN-ONE AI brings AI assistance, creativity, coding and business tools together in one platform.">
  <title>ALL-IN-ONE AI | One Platform. Endless Possibilities.</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #080b14;
      color: #f3f6ff;
    }
    header {
      padding: 20px;
      border-bottom: 1px solid #252c40;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .logo { font-size: 21px; font-weight: bold; color: #73a7ff; }
    nav a {
      color: #dce5ff;
      text-decoration: none;
      margin-left: 12px;
      font-size: 13px;
    }
    .hero {
      text-align: center;
      padding: 65px 18px 45px;
      background: radial-gradient(ellipse at top, #182c58, #080b14 70%);
    }
    .badge {
      display: inline-block;
      border: 1px solid #39568f;
      padding: 8px 13px;
      border-radius: 30px;
      color: #a9c8ff;
      font-size: 12px;
    }
    h1 { font-size: clamp(34px, 8vw, 60px); margin: 22px 0 12px; }
    .highlight { color: #78a8ff; }
    .hero p { color: #b9c3d9; line-height: 1.7; max-width: 580px; margin: auto; }
    .search {
      display: flex;
      max-width: 540px;
      margin: 28px auto 0;
      gap: 8px;
    }
    input {
      min-width: 0;
      flex: 1;
      padding: 15px;
      border: 1px solid #303b55;
      border-radius: 10px;
      background: #111827;
      color: white;
      font-size: 15px;
    }
    button, .button {
      border: 0;
      border-radius: 10px;
      padding: 14px 18px;
      background: #477dff;
      color: white;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
    }
    section { padding: 35px 18px; max-width: 1050px; margin: auto; }
    h2 { text-align: center; margin-bottom: 10px; }
    .sub { text-align: center; color: #aeb9d0; line-height: 1.6; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
      gap: 14px;
      margin-top: 25px;
    }
    .card {
      background: #111725;
      border: 1px solid #263149;
      border-radius: 14px;
      padding: 19px;
    }
    .icon { font-size: 27px; }
    .card h3 { font-size: 16px; }
    .card p { color: #adb8ce; font-size: 13px; line-height: 1.6; }
    .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin-top: 25px; }
    .plan { background: #111725; border: 1px solid #303b55; border-radius: 15px; padding: 23px; }
    .price { font-size: 28px; font-weight: bold; margin: 18px 0; }
    .plan li { color: #c2cbe0; margin: 12px 0; font-size: 14px; }
    .premium { border-color: #568cff; }
    footer { text-align: center; padding: 28px 15px; color: #9ba8c2; border-top: 1px solid #252c40; font-size: 13px; }
    #message { color: #9fc0ff; text-align: center; margin-top: 16px; }
    @media(max-width: 480px) {
      nav { width: 100%; }
      nav a { margin: 0 12px 0 0; }
      .search { flex-direction: column; }
      .hero { padding-top: 45px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="logo">✦ ALL-IN-ONE AI</div>
    <nav>
      <a href="#tools">AI Tools</a>
      <a href="#plans">Plans</a>
      <a href="#about">About</a>
    </nav>
  </header>  <main>
    <div class="hero">
      <span class="badge">🌍 BUILT FOR A WORLD OF POSSIBILITIES</span>
      <h1>One Platform.<br><span class="highlight">Endless Possibilities.</span></h1>
      <p>Your destination for AI assistance, creative ideas, business support and productivity tools — all in one place.</p>
      <form class="search" id="searchForm">
        <input id="toolSearch" type="search" placeholder="What do you want to create today?">
        <button type="submit">Explore Tools</button>
      </form>
      <div id="message" aria-live="polite"></div>
    </div><section id="tools">
  <h2>Explore Your AI Toolbox</h2>
  <p class="sub">Discover tools designed to help you work smarter and create more.</p>
  <div class="grid" id="toolGrid">
    <article class="card" data-search="chat assistant questions answers">
      <div class="icon">🤖</div><h3>AI Assistant</h3>
      <p>Get help with questions, ideas and everyday tasks.</p>
    </article>
    <article class="card" data-search="image art design graphics">
      <div class="icon">🎨</div><h3>Image Studio</h3>
      <p>Explore visual concepts, art and design ideas.</p>
    </article>
    <article class="card" data-search="writing content social media">
      <div class="icon">✍️</div><h3>Content Creator</h3>
      <p>Develop captions, scripts, stories and posts.</p>
    </article>
    <article class="card" data-search="code website programming developer">
      <div class="icon">💻</div><h3>Coding Assistant</h3>
      <p>Learn programming and plan software projects.</p>
    </article>
    <article class="card" data-search="documents cv letters proposals">
      <div class="icon">📄</div><h3>Document Studio</h3>
      <p>Prepare CVs, letters, proposals and reports.</p>
    </article>
    <article class="card" data-search="business marketing planning income">
      <div class="icon">📈</div><h3>Business Assistant</h3>
      <p>Explore marketing, planning and business ideas.</p>
    </article>
  </div>
  <p class="sub" id="searchStatus" aria-live="polite"></p>
</section>

<section id="plans">
  <h2>Choose Your Access</h2>
  <p class="sub">Start free. Upgrade when you're ready for more.</p>
  <div class="plans">
    <div class="plan">
      <h3>Free Explorer</h3>
      <div class="price">₦0 <small>/ start</small></div>
      <ul>
        <li>Browse available tools</li>
        <li>Explore platform features</li>
        <li>Access eligible free services</li>
      </ul>
      <a class="button" href="#tools">Explore Free</a>
    </div>
    <div class="plan premium">
      <h3>Premium Creator</h3>
      <div class="price">Coming Soon</div>
      <ul>
        <li>Planned expanded AI access</li>
        <li>Planned premium features</li>
        <li>Planned subscription options</li>
      </ul>
      <button type="button" id="premiumButton">Join Interest List</button>
    </div>
  </div>
  <p class="sub">Premium access and payments are not active yet.</p>
</section>

<section id="about">
  <h2>AI For Everyone</h2>
  <p class="sub">Our mission is to make useful AI tools easier to discover and use worldwide, with transparent free and paid options.</p>
</section>

  </main>  <footer>
    © <span id="year"></span> ALL-IN-ONE AI. Built for creativity and productivity.
  </footer>  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    document.getElementById("searchForm").addEventListener("submit", function(event) {
      event.preventDefault();
      const query = document.getElementById("toolSearch").value.toLowerCase().trim();
      const cards = [...document.querySelectorAll("#toolGrid .card")];
      let count = 0;

      cards.forEach(function(card) {
        const match = !query ||
          (card.innerText + " " + card.dataset.search).toLowerCase().includes(query);
        card.hidden = !match;
        if (match) count++;
      });

      document.getElementById("searchStatus").textContent =
        count ? count + " tool(s) found." : "No matching tools yet. Try another search.";
    });

    document.getElementById("premiumButton").addEventListener("click", function() {
      alert("Premium membership is coming soon. Payments are not active yet.");
    });
  </script></body>
</html>
